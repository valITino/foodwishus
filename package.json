{
  "name": "foodwishus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FoodwishUs. U cook. I eat. A private meal app for two.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:push": "node tools/build-push.mjs",
    "build:ai": "node tools/build-ai.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "icons": "node tools/make-icons.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/parisienne": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "fractional-indexing": "^4.0.0",
    "motion": "^14.11.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
